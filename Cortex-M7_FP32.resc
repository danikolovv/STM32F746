mach create
machine LoadPlatformDescription @platforms/cpus/stm32f746.repl

# =========================
# LOAD PROGRAM
# =========================
sysbus LoadELF @cifar_eval_m7.elf

# Force execution from reset handler (safe)
sysbus.cpu PC `sysbus GetSymbolAddress "reset_handler"`

# Set stack pointer (top of RAM: 0x20000000 + 384KB)
sysbus.cpu SP 0x20060000

# =========================
# FIXED PERIPHERAL MAPPING
# =========================

# RCC (you were mapping WRONG address before)
sysbus Tag <0x40023800 0x40023FFF> "RCC"

# USART1 (needed for DebugLog)
sysbus Tag <0x40011000 0x400113FF> "USART1"

# GPIOA (used by USART pins)
sysbus Tag <0x40020000 0x400203FF> "GPIOA"

# =========================
# UART OUTPUT
# =========================

# Show UART output in Renode console
showAnalyzer sysbus.usart1

# =========================
# MEMORY FIX (VERY IMPORTANT)
# =========================

# Redirect vector table reads from 0x0 → FLASH
sysbus ZeroRange 0x0 0x400
sysbus Redirect 0x0 0x08000000 0x400

# =========================
# LOGGING / DEBUG
# =========================

logLevel 3

# CPU trace log
sysbus.cpu LogFile @cpu_op_trace.log

# Opcode counting (FPU detection)
sysbus.cpu EnableOpcodesCounting true
sysbus.cpu InstallOpcodeCounterPattern "FPU_OPS" "xxxx1110xxxxxxxxxxxxxxxxxxxxxxxx"

# Translated blocks (JIT insight)
sysbus.cpu LogTranslatedBlocks true

# =========================
# PROFILING
# =========================

sysbus.cpu EnableProfilerCollapsedStack @performance_profile.txt

# =========================
# START
# =========================
start

# Print instruction count after run
sysbus.cpu ExecutedInstructions
